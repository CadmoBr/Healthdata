# ==========================================================
# HEALTHDATA INTELLIGENCE — CONFIGURAÇÃO DE AMBIENTE (.env)
# Copie este arquivo para .env e ajuste conforme seu ambiente
# ==========================================================

# API Oficial de Dados Abertos do SUS
SUS_API_BASE_URL=https://apidadosabertos.saude.gov.br

# Caminhos da Arquitetura Medallion
DATA_BRONZE_PATH=data/bronze
DATA_SILVER_PATH=data/silver
DATA_GOLD_PATH=data/gold

# Banco de Dados PostgreSQL (Data Warehouse)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=healthdata_user
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
POSTGRES_DB=healthdata_dw